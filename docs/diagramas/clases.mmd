---
config:
  layout: elk
---
classDiagram
    direction LR

    class Historia {
        +str titulo
        +str inicio
        +dict variables_iniciales
        +obtener_escena(id_escena) Escena
    }

    class Escena {
        <<abstract>>
        +str id
        +str texto
    }

    class EscenaIntermedia {
    }

    class EscenaFinal {
    }

    class Opcion {
        +str id
        +str texto
        +str destino
        +dict condiciones
        +dict efectos
        +esta_habilitada(variables) bool
    }

    class ErrorDeContenido {
        <<exception>>
    }

    class Partida {
        +Escena escena_actual
        +dict variables
        +tuple respaldo
        +opciones_disponibles() list
        +elegir_por_numero(entrada) bool
        +elegir_opcion(id_opcion) bool
        +en_escena_final() bool
        +sin_opciones_disponibles() bool
        +puede_deshacer() bool
        +deshacer() bool
        +reiniciar()
    }

    Historia "1" *-- "1..*" Escena : contiene
    Escena <|-- EscenaIntermedia
    Escena <|-- EscenaFinal
    EscenaIntermedia "1" *-- "1..*" Opcion : ofrece
    Opcion "*" --> "1" Escena : destino
    Partida "*" --> "1" Historia : juega
    EscenaIntermedia ..> ErrorDeContenido : lanza
    EscenaFinal ..> ErrorDeContenido : lanza
    Partida "*" --> "1" Escena : escena actual
